# Phase 8 — Fastlane lanes for Android deployment. Run `fastlane supply init`
# once after creating the Play Console listing to pull existing metadata.
default_platform(:android)

platform :android do
  desc "Deploy AAB to Google Play internal track (tag-triggered from CI)"
  lane :deploy_internal do
    upload_to_play_store(
      aab: "fastlane/app-release.aab",
      track: "internal",
      release_status: "draft",
      json_key_data: ENV["PLAY_STORE_CONFIG_JSON"]
    )
  end
end
